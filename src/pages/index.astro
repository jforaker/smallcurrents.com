---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';

const currentArtwork = readFileSync(
  join(process.cwd(), 'public/assets/bac9912c0ae7793005f09d99a5b4fe83.svg'),
  'utf8',
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Small Currents — Less friction. More flow.</title>
    <meta name="description" content="We build thoughtful software and simple tools that make everyday work a little easier. Independent, curious, and based in Santa Cruz, California." />
    <link rel="canonical" href="https://smallcurrents.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Small Currents — Less friction. More flow." />
    <meta property="og:description" content="We build thoughtful software and simple tools that make everyday work a little easier." />
    <meta property="og:url" content="https://smallcurrents.com/" />
    <meta name="theme-color" content="#F6F5F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      const savedTheme = localStorage.getItem('small-currents-theme');
      if (savedTheme === 'paper' || savedTheme === 'night') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500&amp;family=Cutive+Mono&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet" />
  </head>
  <body>
<main>
<div class="page">
<svg class="hero-accent" viewBox="0 0 480 480" fill="none" aria-hidden="true" focusable="false">
<defs>
<radialGradient id="accent-wash" cx="35%" cy="25%" r="80%">
<stop stop-color="#334a94" stop-opacity=".25" />
<stop offset="1" stop-color="#334a94" stop-opacity="0" />
</radialGradient>
<filter id="accent-grain" x="0" y="0" width="100%" height="100%">
<feTurbulence type="fractalNoise" baseFrequency=".65" numOctaves="3" stitchTiles="stitch" />
<feColorMatrix type="saturate" values="0" />
<feComposite in2="SourceGraphic" operator="in" />
<feBlend in="SourceGraphic" mode="soft-light" />
</filter>
</defs>
<circle cx="345" cy="242" r="178" fill="url(#accent-wash)" filter="url(#accent-grain)" />
<circle cx="300" cy="140" r="222" stroke="#334a94" stroke-width="1" />
</svg>

<div class="container">
<header class="site-header">
<a href="#top" class="brand">
<span class="brand-name">Small Currents</span>
<span class="brand-dot"></span>
</a>
<button type="button" class="theme-toggle" aria-label="Current theme: Paper. Switch to Night" title="Switch theme">
<svg class="theme-icon theme-icon-paper" viewBox="0 0 32 32" fill="none" aria-hidden="true">
<path transform="translate(1.5 0)" d="M11.5 17a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
<path transform="translate(1.5 0)" d="M17 5v3M9.5 7.2l1.8 2.6M24.5 7.2l-1.8 2.6M5.8 11.8l2.7 1.5M28.2 11.8l-2.7 1.5M5.5 17h2.5M26 17h2.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
<path d="M3 23c3 3 6.5.4 10-2 3.2-2.2 6.1-3.9 8.4-3.1 1.8.6 2.1 2.3 1.1 2.8-.8.4-1.1-.7-2.2-.5-1.4.2-2 1.6-1.5 2.6 1.2 2.5 5.2.9 8.1.9 1.1 0 1.9.2 2.6.6" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
</svg>
<svg class="theme-icon theme-icon-night" viewBox="0 0 32 32" fill="none" aria-hidden="true">
<path d="M23.5 21.5A9 9 0 0 1 12 10a9 9 0 1 0 11.5 11.5Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
<path d="M21 5.5v4M19 7.5h4M26 12v3M24.5 13.5h3" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
<circle cx="17" cy="14" r=".8" fill="currentColor" />
</svg>
</button>
</header>

<section id="top" class="hero">
<h1 class="hero-title"><span class="hero-line">Less friction.</span><span class="hero-line">More <em class="hero-flow">flow.</em></span></h1>
<div class="hero-details">
<div class="hero-copy">
<p class="hero-description">We build thoughtful software and simple tools that make everyday work a little easier.</p>
<p class="hero-location">Independent, curious, and based in Santa Cruz, California.</p>
</div>
<a href="mailto:jake@smallcurrents.com" class="sc-btn contact-button">Get in touch</a>
</div>
</section>
</div>

<Fragment set:html={currentArtwork} />

<div class="container">

<section id="approach" class="approach">
<h2 class="section-label"><span class="section-number">01</span>Approach</h2>
<div class="approach-copy">
<p class="approach-intro">Small Currents is an independent studio for useful software.</p>
<p class="approach-description">We look for opportunities to make work feel more manageable—with thoughtful tools that remove friction and make room for what matters.</p>
<p class="approach-description">Sometimes that means a small product. Sometimes it’s a focused tool. Either way, we want to make useful things that feel simple to use.</p>
</div>
</section>

<section id="make" class="make">
<h2 class="section-label"><span class="section-number">02</span>What we build</h2>
<ul class="offerings">
<li class="sc-row offering">Small software products</li>
<li class="sc-row offering">Internal tools</li>
<li class="sc-row offering">Tools for everyday workflows</li>
<li class="sc-row offering">Lightweight business systems</li>
</ul>
</section>

</div>

<section id="contact" class="contact">
<div class="container">
<div class="contact-content">
<h2 class="contact-title">Have something that feels more complicated than it should?</h2>
<p class="contact-email"><span class="contact-prompt">Say hello:</span><a href="mailto:jake@smallcurrents.com" class="email-link">jake@smallcurrents.com</a></p>
<p class="contact-description">We’re especially interested in small, practical problems worth solving well.</p>
</div>
<footer class="site-footer">
<span class="footer-brand">Small Currents</span>
<span>Santa Cruz, California</span>
<span>© 2026 Small Currents</span>
</footer>
</div>
</section>

</div>
</main>
<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const colorPreference = window.matchMedia('(prefers-color-scheme: dark)');
  const activeTheme = () => document.documentElement.dataset.theme || (colorPreference.matches ? 'night' : 'paper');
  const updateThemeToggle = () => {
    const isNight = activeTheme() === 'night';
    themeToggle?.setAttribute('aria-label', `Current theme: ${isNight ? 'Night' : 'Paper'}. Switch to ${isNight ? 'Paper' : 'Night'}`);
  };

  themeToggle?.addEventListener('click', () => {
    const theme = activeTheme() === 'paper' ? 'night' : 'paper';
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('small-currents-theme', theme);
    updateThemeToggle();
  });

  colorPreference.addEventListener('change', updateThemeToggle);
  updateThemeToggle();
</script>
  </body>
</html>
